{
  "name": "pinball-illusions-html",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean-room browser reconstruction of the AGA release of Pinball Illusions.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && npm run guard:public",
    "verify": "npm test && npm run build",
    "guard:public": "node scripts/check-public-build.mjs dist"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.0",
    "xbrz-js": "1.9.2"
  }
}
